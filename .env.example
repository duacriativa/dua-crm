# ─── Banco de Dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dua_crm"
POSTGRES_USER=dua_crm
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=dua_crm

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Bypass de login (acesso direto sem autenticação) ────────────────────────
# Defina como true para desativar o login e acessar o CRM diretamente
# ATENÇÃO: use apenas em redes internas/privadas
DISABLE_AUTH=false

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api-dua-crm.railway.app

# ─── Encryption (AES-256 para dados sensíveis) ────────────────────────────────
ENCRYPTION_KEY=chave_de_32_caracteres_exatamente

# ─── WhatsApp Cloud API oficial (Meta) — coexistência ────────────────────────
# Ver docs/WHATSAPP_OFICIAL.md
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WA_WEBHOOK_VERIFY_TOKEN=troque_por_uma_string_aleatoria
GRAPH_API_VERSION=v23.0
# Eventos do funil para a Meta (Conversions API / Business Messaging). false desliga.
META_CAPI_ENABLED=true
# Opcional: código do "Testar eventos" do Gerenciador de Eventos (só para testes)
META_CAPI_TEST_CODE=
# Pixel do site (leads que não vieram de anúncio de WhatsApp): ID e token da Conversions API
# (Gerenciador de Eventos → Pixel → Configurações → Gerar token de acesso)
META_PIXEL_ID=
META_PIXEL_TOKEN=
