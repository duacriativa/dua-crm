generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Plan {
  ESSENCIAL
  CRESCIMENTO
  ESCALA
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum Channel {
  WHATSAPP
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
}

enum ContactType {
  LEAD
  CLIENT
}

enum LeadQualification {
  ULTRA       // ICP — faturamento alto + estrutura
  QUALIFIED   // Qualificado — potencial médio
  COLD        // Frio — iniciando
  UNQUALIFIED // Ainda não qualificado (padrão)
}

enum ContactSegment {
  NEW       // nunca comprou
  ACTIVE    // comprou nos últimos 60 dias
  VIP       // top 20% por valor gasto
  AT_RISK   // comprou antes, sumiu há 30-60 dias
  DORMANT   // sem compra há +60 dias
}

enum OrderSource {
  NUVEMSHOP
  SHOPIFY
  WOOCOMMERCE
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum IntegrationType {
  NUVEMSHOP
  SHOPIFY
  WOOCOMMERCE
  GOOGLE      // Google Agenda (agendamento próprio): refresh token na config criptografada
  META_ADS    // Meta Ads (só leitura, ads_read): token long-lived + conta de anúncios na config criptografada
}

enum ContractStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum ContractServiceType {
  SOCIAL_MEDIA       // Gerenciamento de Redes Sociais
  PAID_TRAFFIC       // Tráfego Pago / Anúncios
  CRM_SETUP          // Implantação de CRM
  CONSULTING         // Consultoria
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum AutomationTrigger {
  ABANDONED_CART         // carrinho abandonado no ecommerce
  ORDER_DELIVERED        // pedido entregue
  ORDER_PAID             // pagamento confirmado
  NEW_FOLLOWER           // novo seguidor no Instagram
  CONTACT_DORMANT        // cliente sem compra há N dias
  CONTACT_AT_RISK        // cliente em risco de churn
  LEAD_FORM_SUBMITTED    // lead preencheu o formulário do site (POST /webhooks/lead)
  LEAD_STAGE_ENTERED     // card criado/movido para uma etapa do funil (conditions.stageId)
  WHATSAPP_FIRST_MESSAGE // contato novo mandou a 1ª mensagem no WhatsApp (sem formulário)
  MEETING_SCHEDULED      // reunião marcada pelo agendamento próprio (meeting.scheduled)
}

// Itens da linha do tempo do contato além das mensagens (tarefas, eventos do funil… virão depois)
enum ActivityType {
  NOTE                   // nota interna: só a equipe vê, não vai para o WhatsApp
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// ─── MODELOS ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(ESSENCIAL)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  contacts         Contact[]
  conversations    Conversation[]
  campaigns        Campaign[]
  automations      Automation[]
  integrations     Integration[]
  bookingPages     BookingPage[]
  meetings         Meeting[]
  metaCredential   MetaCredential?
  auditLogs        AuditLog[]
  pipelines        Pipeline[]
  activities       Activity[]
  contracts        Contract[]
  financialEntries FinancialEntry[]
  services         Service[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  signatures   String[] @default([]) // assinaturas das mensagens (ex: "Financeiro")
  signature    String?  // assinatura selecionada no momento
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  activities    Activity[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique  // bcrypt hash do token
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Contact {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  phone           String?        // formato E.164: +5511999999999
  instagramId     String?        // Instagram user ID
  instagramHandle String?
  email           String?
  tags            String[]
  segment         ContactSegment @default(NEW)
  totalSpent      Float          @default(0)
  orderCount      Int            @default(0)
  lastPurchaseAt  DateTime?
  notes               String?
  analysisInstagram   String?
  // Qualificação de lead
  qualification       LeadQualification @default(UNQUALIFIED)
  leadScore           Int               @default(0)
  monthlyRevenue      String?           // faturamento mensal (ex: "R$50k–R$100k")
  saleModel           String?           // modelo de venda (ex: "Loja física + online")
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  // Origem do lead para relatórios: ADS | ORGANIC | REFERRAL | OTHER (null = não informado)
  leadOrigin          String?
  // Anúncio de clique para WhatsApp (bloco "referral" da Meta na 1ª mensagem)
  adId                String?
  adHeadline          String?
  adSourceUrl         String?
  adCtwaClid          String?
  adReferredAt        DateTime?
  type                ContactType    @default(LEAD)
  profilePicUrl       String?
  clientSince         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  conversations  Conversation[]
  orders         Order[]
  pipelineLeads  PipelineLead[]
  contracts      Contract[]
  activities     Activity[]
  meetings       Meeting[]

  @@unique([tenantId, phone])
  @@unique([tenantId, instagramId])
  @@index([tenantId])
  @@index([tenantId, segment])
}

model Conversation {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact            @relation(fields: [contactId], references: [id])
  channel    Channel
  status     ConversationStatus @default(OPEN)
  assignedTo    String?            // userId
  externalId    String?            // ID da conversa no Meta
  profilePicUrl String?            // Avatar URL
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages   Message[]
  activities Activity[]

  @@unique([tenantId, externalId])
  @@index([tenantId, status])
  @@index([contactId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  mediaUrl       String?
  mediaId        String?          // ID da mídia na WhatsApp Cloud API (download sob demanda)
  templateName   String?
  externalId     String?          // Meta message ID
  senderName       String?        // nome de quem enviou (em grupos: pushName do remetente)
  quotedContent    String?        // texto da mensagem citada (reply)
  quotedExternalId String?        // externalId da mensagem citada
  quotedType       String?        // tipo da mensagem citada (TEXT/IMAGE/etc)
  sentAt         DateTime         @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  errorCode      String?

  @@index([conversationId])
  @@index([externalId])
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  contactId   String
  contact     Contact     @relation(fields: [contactId], references: [id])
  externalId  String
  source      OrderSource
  total       Float
  status      OrderStatus
  items       Json        // [{ name, sku, qty, price }]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, externalId, source])
  @@index([tenantId])
  @@index([contactId])
}

model Integration {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      IntegrationType
  config    String          // JSON criptografado (AES-256)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([tenantId, type])
}

model MetaCredential {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId   String
  accessToken     String  // criptografado AES-256
  wabaId          String  // WhatsApp Business Account ID
  verifyToken     String  // para validação do webhook
  instagramPageId String?
  instagramToken  String? // criptografado AES-256
}

model Automation {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  trigger     AutomationTrigger
  conditions  Json              // ex.: { onlyPhones: ["+5585..."] } para testar só com alguns números
  actions     Json              // passos do bot, executados em ordem (ver automations/automation-steps.ts)
  active      Boolean           @default(true)
  runCount    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  runs AutomationRun[]

  @@index([tenantId, trigger, active])
}

// Uma "sessão" do bot com um contato: em que passo está e quando continua.
// Fica no banco para sobreviver a reinício/deploy no meio de uma espera.
model AutomationRun {
  id             String     @id @default(cuid())
  tenantId       String
  automationId   String
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId      String
  conversationId String?
  status         String     @default("RUNNING") // RUNNING | WAITING_REPLY | COMPLETED | FAILED | CANCELLED
  stepIndex      Int        @default(0)
  nextRunAt      DateTime?  // quando o executor retoma (espera de tempo / limite da espera por resposta)
  sentCount      Int        @default(0)
  isTest         Boolean    @default(false) // disparado pelo "Testar" da tela (roda mesmo com o bot pausado)
  repliedAt      DateTime?  // o contato respondeu durante o bot (conta como conversão)
  lastError      String?
  visitedSteps   String[]   @default([]) // ids dos passos por onde a sessão passou (contadores do editor)
  meetingId      String?    // reunião que disparou a sessão (gatilho "Reunião agendada"; esperas relativas ao horário dela)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime   @updatedAt

  @@index([status, nextRunAt])
  @@index([automationId])
  @@index([contactId, status])
  @@index([meetingId])
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  message     String
  mediaUrl    String?
  segment     Json
  status      CampaignStatus @default(DRAFT)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([tenantId, status])
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]

  @@index([tenantId])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#6366F1")
  position   Int      @default(0)
  kind       String   @default("OPEN") // OPEN | WON (ganho) | LOST (perdido)

  leads PipelineLead[]

  @@index([pipelineId])
}

model PipelineLead {
  id        String        @id @default(cuid())
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact       @relation(fields: [contactId], references: [id])
  value     Float?
  notes     String?
  position  Int           @default(0)
  wonAt      DateTime?     // entrou numa etapa de ganho (value = valor fechado)
  lostAt     DateTime?
  lostReason String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([stageId])
  @@index([contactId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  action     String   // ex: "contact.delete", "campaign.send"
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Contract {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  contactId       String?             // link com Contact (lead que virou cliente)
  contact         Contact?            @relation(fields: [contactId], references: [id])
  asaasCustomerId String?             // ID do cliente no Asaas
  serviceType     ContractServiceType
  description     String?
  totalValue      Float               // valor total do contrato
  monthlyValue    Float               // valor mensal (recorrente)
  installments    Int                 @default(1) // 1 = recorrente indefinido
  installmentsPaid Int                @default(0)
  status          ContractStatus      @default(ACTIVE)
  signedAt        DateTime            // data de assinatura (cadastro manual)
  startsAt        DateTime
  endsAt          DateTime?           // null = recorrente sem fim
  clicksignDocId  String?             // ID do doc no Clicksign (futuro)
  notes           String?
  cancellationReason String?          // motivo do cancelamento
  cancelledAt     DateTime?           // quando foi cancelado
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  financialEntries FinancialEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model FinancialEntry {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract?     @relation(fields: [contractId], references: [id])
  asaasPaymentId  String?       @unique  // ID do pagamento no Asaas
  clientName      String
  description     String?
  value           Float
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime
  paidAt          DateTime?
  isCommission    Boolean       @default(false) // comissões (ex: Kommo)
  installmentNum  Int?          // qual parcela (1, 2, 3...)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([asaasPaymentId])
}

// ─── Módulo de Serviços ───────────────────────────────────────────────────────

model Service {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Float     @default(0)
  cost            Float     @default(0)
  currency        String    @default("BRL")
  category        String?
  isRecurring     Boolean   @default(false)
  recurringPeriod String?   // "mensal" | "trimestral" | "semestral" | "anual"
  isPublic        Boolean   @default(true)   // exibir no portfólio
  isOnForm        Boolean   @default(true)   // exibir no formulário de leads
  commission      Float?    // % comissão padrão
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Kommo Integration ────────────────────────────────────────────────────────

model KommoLead {
  id        String   @id @default(cuid())
  tenantId  String
  kommoId   Int
  name      String
  stageId   Int?
  stageName String?
  status    String   @default("active") // active | won | lost
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kommoId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Aparelhos que recebem notificação push (PWA do CRM)
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Configurações internas do sistema (ex.: chaves VAPID geradas automaticamente)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Linha do tempo do contato: notas internas (e, depois, tarefas e eventos)
model Activity {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?       // conversa onde foi criada (a nota continua no contato se a conversa for excluída)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type           ActivityType  @default(NOTE)
  content        String
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?       // nome exibido (assinatura escolhida ou nome do usuário)
  recipientName  String?       // destinatário da mensagem interna (assinatura), ex.: "Daniel"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([contactId, createdAt])
}

// ─── Agendamento próprio (substitui o Calendly) ──────────────────────────────

// Tipo de evento com link público /agendar/[slug] e a disponibilidade dele.
// Horários no fuso `timezone`; ver scheduling/availability.ts.
model BookingPage {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug           String   @unique
  title          String
  description    String?
  durationMin    Int      @default(45)
  bufferAfterMin Int      @default(15)  // intervalo livre depois de cada reunião
  slotStepMin    Int      @default(60)  // de quanto em quanto tempo os horários começam
  minNoticeMin   Int      @default(240) // antecedência mínima para agendar
  maxDaysAhead   Int      @default(30)  // até quantos dias à frente
  timezone       String   @default("America/Sao_Paulo")
  weeklyHours    Json     // { "1": [["09:00","17:00"]], ... } (0 = domingo)
  dateOverrides  Json     @default("{}") // { "2026-11-02": [] } — dia fechado ou faixas próprias
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meetings Meeting[]

  @@index([tenantId])
}

model Meeting {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingPageId     String?
  bookingPage       BookingPage? @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  contactId         String
  contact           Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title             String
  startAt           DateTime
  endAt             DateTime
  status            String       @default("SCHEDULED") // SCHEDULED | CANCELLED | NO_SHOW | COMPLETED
  name              String
  email             String
  phone             String?
  notes             String?
  meetLink          String?
  googleEventId     String?
  manageToken       String       @unique // link do cliente para remarcar/cancelar
  rescheduleCount   Int          @default(0)
  cancelledAt       DateTime?
  cancelledBy       String?      // CLIENT | TEAM
  cancelReason      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tenantId, startAt])
  @@index([contactId])
}

// ─── Instagram (API do Instagram com Login do Facebook) ──────────────────────

// Conta profissional do Instagram ligada à Página do Facebook, com o token da Página.
// Sem relação com Tenant de propósito: tabela nova criada pelo ensureSchema (ver prisma.service.ts).
model InstagramAccount {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  pageId    String
  pageName  String?
  igUserId  String   @unique // id da conta profissional (entry.id dos webhooks)
  username  String?
  pageToken String   // token da Página, criptografado AES-256
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Regra de palavra-chave do Instagram (estilo ManyChat): comentário, resposta/menção a story ou DM → DM automática.
model InstagramAutomation {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  trigger       String   // COMMENT | STORY_REPLY | STORY_MENTION | DM_KEYWORD | FIRST_DM (boas-vindas)
  keywords      String[] @default([]) // vazio = qualquer texto
  mediaIds      String[] @default([]) // COMMENT: só nesses posts/reels (vazio = todos)
  dmText        String   // resposta privada (comentário) ou DM
  publicReplies String[] @default([]) // COMMENT: resposta pública ao comentário (sorteia uma)
  buttons       Json     @default("[]") // até 3: { title, url } abre link; { title } sem url responde o título (encadeia outra regra)
  stageId       String?  // etapa do funil onde o contato entra (vazio = 1ª etapa do funil principal)
  tag           String?  // etiqueta colocada no contato
  active        Boolean  @default(true)
  runCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, trigger, active])
}

// Comentário já tratado por uma regra: a Private Replies API aceita só 1 resposta por comentário.
model InstagramCommentReply {
  commentId    String   @id
  tenantId     String
  automationId String?
  mediaId      String?
  username     String?
  text         String?
  status       String   // SENT | FAILED
  error        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}
